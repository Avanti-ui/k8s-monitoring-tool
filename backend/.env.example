# Backend Server
HOST=0.0.0.0
PORT=4000
DEBUG=false

# Security & Auth
JWT_SECRET=super-secret-k8s-monitor-jwt-key-2026

# Database
MONGO_URI=mongodb://localhost:27017/k8s-monitor

# Observability Upstreams
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100

# Alert Rule Engine
RULE_ENGINE_INTERVAL_MS=30000

# Slack Webhook Integrations
# Webhook #1: Immediate rule threshold violations (e.g. #k8s-alerts)
SLACK_WEBHOOK_URL_ALERTS=https://hooks.slack.com/services/YOUR/ALERT/WEBHOOK

# Webhook #2: Intelligent AI Incident Analysis & Root Causes (e.g. #k8s-ai-insights)
SLACK_WEBHOOK_URL_AI_ANALYSIS=https://hooks.slack.com/services/YOUR/AI/WEBHOOK

# AI Anomaly Detection Settings
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_ANALYSIS_INTERVAL_MS=180000

# API Keys (Configure the one matching AI_PROVIDER)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=sk-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
AZURE_OPENAI_API_KEY=your_azure_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
